# ---------------------------------------------------------------------------
# 复制本文件为 .env 后按需修改。.env 不要提交到版本库。
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# 数据库（本机 Homebrew PostgreSQL 16）
DB_NAME=iot_edu_platform
DB_USER=chenguangxi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# 后台任务：不配 Celery 时走本地工作线程池，池大小即并发上限
# 任务会各占一个数据库连接并调用模型接口，不宜设太大
TASKS_MAX_WORKERS=4

# 聊天接口每用户每分钟的调用上限（0 表示不限制）
CHAT_RATE_LIMIT_PER_MINUTE=20

# 前端来源
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 向量维度：必须与所选向量模型一致。改这里需要重新生成迁移并重建切片向量。
#   text-embedding-v3 / bge-m3  → 1024
#   text-embedding-3-small      → 1536
EMBEDDING_DIM=1024

# 大语言模型（OpenAI 兼容协议）
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 向量模型（OpenAI 兼容协议）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# 检索与切片默认参数
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 上传限制
MAX_UPLOAD_SIZE_MB=200
